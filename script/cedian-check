#!/usr/bin/env bash
# Format, lint and test the cedian crates, and test the upstream crates cedian
# changes (ADR-0042), so a check never builds all of Zed.
# `script/cedian-check check` stops after `cargo check`.
set -euo pipefail
# Git sets GIT_DIR when it runs a hook, and with it `rev-parse --show-toplevel`
# answers the current directory, not the checkout a worktree is. Unset, so the
# discovery from this script's own directory is what answers.
cd "$(unset GIT_DIR GIT_WORK_TREE; git -C "$(dirname "$0")" rev-parse --show-toplevel)"
export PATH="$HOME/.cargo/bin:$PATH"
export CARGO_PROFILE_DEV_DEBUG=${CARGO_PROFILE_DEV_DEBUG:-line-tables-only}
# A full disk mid-build fails with no useful message; free build output first.
# One check run needs about 9 GB, and linking the test binaries added on top of
# what was there when the run started, so keep 20 GB free (12 GB was not enough:
# the run of 2026-10-11 died in `ld` with 12 GB free and no `incremental` pruned).
script/cedian-prune 20

crates=(omp-rpc)
for dir in crates/cedian_*; do
  name=$(basename "$dir")
  # Its benches turn on gpui's `bench-support`, and cargo unifies features
  # across the packages of one run: the gate would rebuild and test all of
  # them with it. Run it by hand: `cargo bench -p cedian_bench`.
  [ "$name" = cedian_bench ] && continue
  crates+=("$name")
done
pkgs=()
for c in "${crates[@]}"; do pkgs+=(-p "$c"); done
# Upstream crates cedian changes are tested, not linted.
upstream=()
for c in settings settings_content settings_ui theme_settings client onboarding; do
  upstream+=(-p "$c")
done

files=()
while IFS= read -r f; do files+=("$f"); done < <(find crates/cedian_* -name '*.rs' -not -path '*/target/*')
rustfmt --edition 2024 --check "${files[@]}"
script/check-licenses
# The docs' ADR index (cedian/docs/decisions) stays in step with its files.
cedian/script/check-adrs
# The benchmark harness: turn cap, OMP wrapper, model check (fake OMP only).
python3 script/cedian-bench/test_bench.py
script/cedian-bench/test-watchdog.sh
if [ "${1:-}" = check ]; then
  cargo check -j4 --all-targets "${pkgs[@]}" "${upstream[@]}"
  exit 0
fi
# Vendored upstream code is built and tested, not linted.
lint=("${pkgs[@]:2}")
cargo clippy -j4 --all-targets --no-deps "${lint[@]}" -- -D warnings
# cedian_bench is skipped above (feature unification); lint its benches alone.
# --no-deps: benches pull gpui; do not apply -D warnings to upstream.
cargo clippy -j4 -p cedian_bench --benches --no-deps -- -D warnings
# Tests run with an empty HOME so one that reads the owner's real ~/.omp fails
# here the way it fails on CI. Cargo and rustup keep their real homes.
export CARGO_HOME="${CARGO_HOME:-$HOME/.cargo}" RUSTUP_HOME="${RUSTUP_HOME:-$HOME/.rustup}"
test_home=$(mktemp -d)
test_tmp=$(mktemp -d)
export TMPDIR="$test_tmp"
export CEDIAN_STATE_DIR="$test_home/cedian-state"
mkdir -p "$CEDIAN_STATE_DIR"
# Snapshot cedian-* temp dirs so a leak from this run is visible.
before_tmp=$(mktemp)
find "$test_tmp" -maxdepth 1 -type d -name 'cedian-*' 2>/dev/null | sort >"$before_tmp" || true
trap 'rm -rf "$test_home" "$test_tmp" "$before_tmp"' EXIT
HOME="$test_home" cargo test -j4 "${pkgs[@]}" "${upstream[@]}"
after_tmp=$(mktemp)
find "$test_tmp" -maxdepth 1 -type d -name 'cedian-*' 2>/dev/null | sort >"$after_tmp" || true
leaked=$(comm -13 "$before_tmp" "$after_tmp" || true)
rm -f "$after_tmp"
if [ -n "$leaked" ]; then
  echo "cedian-check: new cedian-* temp dirs left behind:" >&2
  echo "$leaked" >&2
  exit 1
fi
