#!/usr/bin/env bash
# Build the app's OMP from the fork submodule `vendor/cedian-agent` (ADR-0075
# decision 5) into target/omp/omp, with target/omp/omp.stamp recording the
# source commit and the binary's sha256. The app runs only a build whose stamp
# names the pinned commit (`vendor/omp-revision.json`), so `omp --version`,
# which reads the same for every build of a version, is never the check.
#
# Idempotent: a stamp that names the submodule's commit and matches the binary
# skips the build. Prints the binary's sha256 either way.
#
# Prerequisites: the submodule checked out (`git submodule update --init
# vendor/cedian-agent`); bun >= 1.4 (1.4.2 tested); rustup, which installs the
# nightly that vendor/cedian-agent/rust-toolchain.toml names. A cold native build
# takes about 15 min on 10 cores and needs about 10 GB under target/omp-native.
set -euo pipefail
cd "$(unset GIT_DIR GIT_WORK_TREE; git -C "$(dirname "$0")" rev-parse --show-toplevel)"
export PATH="$HOME/.cargo/bin:$HOME/.bun/bin:$PATH"

SRC=vendor/cedian-agent
OUT=target/omp
PIN=$(python3 -c 'import json; print(json.load(open("vendor/omp-revision.json"))["commit"])')

[ -f "$SRC/package.json" ] || {
  echo "cedian-omp-build: $SRC is empty; run: git submodule update --init $SRC" >&2
  exit 2
}
COMMIT=$(git -C "$SRC" rev-parse HEAD)
if [ "$COMMIT" != "$PIN" ]; then
  echo "cedian-omp-build: $SRC is at $COMMIT but vendor/omp-revision.json pins $PIN; check out the pin or update the pin file in the same change" >&2
  exit 2
fi
if [ -n "$(git -C "$SRC" status --porcelain --untracked-files=no)" ]; then
  echo "cedian-omp-build: $SRC has local changes; a stamp would not describe them" >&2
  exit 2
fi

stamped() {
  [ -f "$OUT/omp" ] && [ -f "$OUT/omp.stamp" ] && python3 - "$OUT" "$COMMIT" <<'PY'
import hashlib, json, sys
out, commit = sys.argv[1], sys.argv[2]
stamp = json.load(open(f"{out}/omp.stamp"))
sha = hashlib.sha256(open(f"{out}/omp", "rb").read()).hexdigest()
sys.exit(0 if stamp.get("commit") == commit and stamp.get("sha256") == sha else 1)
PY
}

if stamped; then
  echo "cedian-omp-build: $OUT/omp is already the build of $COMMIT"
else
  command -v bun >/dev/null || { echo "cedian-omp-build: bun >= 1.4 is required (https://bun.sh)" >&2; exit 2; }
  command -v rustup >/dev/null || { echo "cedian-omp-build: rustup is required" >&2; exit 2; }
  root=$PWD
  (
    cd "$SRC"
    bun install --frozen-lockfile
    CARGO_TARGET_DIR="$root/target/omp-native" OMP_NATIVE_CARGO_PROFILE=ci bun run build:native
    bun --cwd=packages/coding-agent run build
  )
  mkdir -p "$OUT"
  rm -f "$OUT/omp.stamp"
  cp "$SRC/packages/coding-agent/dist/omp" "$OUT/omp.new"
  mv "$OUT/omp.new" "$OUT/omp"
  SHA=$(shasum -a 256 "$OUT/omp" | cut -d' ' -f1)
  printf '{"commit":"%s","sha256":"%s"}\n' "$COMMIT" "$SHA" >"$OUT/omp.stamp"
  # The build regenerates tracked files in the submodule; leave it at the pin.
  git -C "$SRC" checkout -q -- .
fi
python3 -c 'import json,sys; print("cedian-omp-build: sha256", json.load(open(sys.argv[1]))["sha256"], sys.argv[2])' "$OUT/omp.stamp" "$OUT/omp"
