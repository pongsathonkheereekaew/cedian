#!/bin/sh
# pre-commit: deterministic feedback loop (aihero: hooks > prose).
# Runs fmt check, clippy with workspace lints, and hermetic unit tests.
# Live-model tests (--ignored) never gate commits.
set -eu
export PATH="$HOME/.cargo/bin:$PATH"

fail() { echo "pre-commit: $1" >&2; exit 1; }

cargo fmt --all -- --check >/dev/null 2>&1 || fail "run 'cargo fmt --all' (fmt drift)"
cargo clippy --workspace --all-targets -- -D warnings >/dev/null 2>&1 \
  || fail "clippy failed — fix warnings before commit"
cargo test --workspace >/dev/null 2>&1 \
  || fail "unit tests failed — fix before commit"

echo "pre-commit: fmt + clippy + tests green"
