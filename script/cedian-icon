#!/usr/bin/env bash
# Write cedian/assets/AppIcon.icns from the brand kit's macOS app icon
# (cedian/brand/app-icon/macos-1024.png), every iconset size 16..512 @1x/@2x.
#
#     script/cedian-icon                 # write the .icns
#     script/cedian-icon --out x.icns    # write it elsewhere
set -euo pipefail
cd "$(dirname "$0")/.."
SRC=cedian/brand/app-icon/macos-1024.png
OUT=cedian/assets/AppIcon.icns
if [ "${1:-}" = --out ]; then OUT=$2; fi
TMP=$(mktemp -d); trap 'rm -rf "$TMP"' EXIT
SET="$TMP/AppIcon.iconset"; mkdir "$SET"
for s in 16 32 128 256 512; do
  sips -z $s $s "$SRC" --out "$SET/icon_${s}x${s}.png" >/dev/null
  d=$((s * 2))
  sips -z $d $d "$SRC" --out "$SET/icon_${s}x${s}@2x.png" >/dev/null
done
iconutil -c icns "$SET" -o "$OUT"
echo "cedian-icon: $OUT"
